# Dry Data — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# FRED API (free key from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your-fred-key-here

# Database
DUCKDB_PATH=data/dry_data.duckdb

# Logging
LOG_LEVEL=INFO
